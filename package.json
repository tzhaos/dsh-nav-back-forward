{
  "name": "dsh-nav-back-forward",
  "version": "1.3.4",
  "private": true,
  "description": "Back and forward controls for DeepSeek Harness session navigation, pinned to the sidebar's top-right in the Windows caption row.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "navigation",
    "back",
    "forward",
    "session",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzhaos/dsh-nav-back-forward.git"
  },
  "homepage": "https://github.com/tzhaos/dsh-nav-back-forward#readme",
  "bugs": {
    "url": "https://github.com/tzhaos/dsh-nav-back-forward/issues"
  }
}
